<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- These are NuGet package metadata for templates/MiniMica.Templates only.
         The application's own version and copyright come from
         src/MiniMicaApp/Properties/AssemblyInfo.cs, which is authoritative because
         MiniMicaApp sets GenerateAssemblyInfo=false. Do not add AssemblyVersion or
         FileVersion here: they would silently do nothing for the app and invite drift. -->
    <Version>5.0.0</Version>
    <Authors>Fat Free Gravity</Authors>
    <Copyright>Copyright © 2025-2026 Fat Free Gravity</Copyright>
  </PropertyGroup>
</Project>
