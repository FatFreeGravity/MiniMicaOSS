<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MiniMicaApp.Controls"
                    xmlns:i18n="clr-namespace:MiniMicaApp.Localization">

    <Style x:Key="MiniMica.PanButtonStyle" TargetType="RepeatButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="#66FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource MiniMica.TextPrimaryBrush}" />
        <!-- v4.1 parity: Segoe MDL2 Assets at 12 with the E0E2/E0E3 chevrons, matching
             the ScrollArrowButton style the pan affordance is derived from. -->
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Reachable by keyboard: when the canvas overflows these are the only way to
             see the clipped content without a mouse. -->
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource MiniMica.FocusVisual}" />
        <Setter Property="Delay" Value="300" />
        <Setter Property="Interval" Value="45" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid>
                        <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource MiniMica.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource MiniMica.ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MiniMica.FixedPageHostStyle" TargetType="{x:Type controls:FixedPageHost}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FixedPageHost}">
                    <Grid ClipToBounds="True">
                        <ScrollViewer x:Name="PART_Scroller"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      CanContentScroll="False"
                                      PanningMode="HorizontalOnly">
                            <Border Width="{TemplateBinding DesignWidth}"
                                    Height="{TemplateBinding DesignHeight}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MiniMica.PageBackgroundBrush}"
                                    BorderBrush="{DynamicResource MiniMica.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <!-- Opacity is theme-driven: 0.25 light, 0.75 dark and
                                         0 under a Windows contrast theme, where a soft
                                         shadow is noise against a deliberately flat
                                         palette. v4.1 zeroed DropShadow.Opacity in code. -->
                                    <DropShadowEffect ShadowDepth="8"
                                                      Direction="315"
                                                      Color="#808080"
                                                      Opacity="{DynamicResource MiniMica.PageShadowOpacity}"
                                                      BlurRadius="25" />
                                </Border.Effect>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Border>
                        </ScrollViewer>

                        <RepeatButton x:Name="PART_PanLeft"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"
                                      Content="&#xE0E2;"
                                      Style="{StaticResource MiniMica.PanButtonStyle}"
                                      ToolTip="{i18n:Loc Key=pan_left}"
                                      AutomationProperties.Name="{i18n:Loc Key=pan_left}" />
                        <RepeatButton x:Name="PART_PanRight"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"
                                      Content="&#xE0E3;"
                                      Style="{StaticResource MiniMica.PanButtonStyle}"
                                      ToolTip="{i18n:Loc Key=pan_right}"
                                      AutomationProperties.Name="{i18n:Loc Key=pan_right}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
